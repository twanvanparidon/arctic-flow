# Build the binary in a container.
#
#   docker build -f packaging/Dockerfile.build -t atf-build .
#   docker create --name atf-out atf-build
#   docker cp atf-out:/out/atf ./dist/
#   docker rm atf-out
#
# Two reasons this is the build path rather than a local pyinstaller run:
#
#   Reproducibility. The binary embeds a Python interpreter and compiled wheels, so the
#   build environment is part of the artefact. Pinning it in a Dockerfile means a build
#   from the same commit and tag produces the same thing on any machine, and it is the
#   same recipe CI would use. The tag is part of that: it is the version, and it enters
#   through --build-arg VERSION because no checkout knows which ref points at it.
#
#   glibc. A frozen binary links against the glibc it was built on and will not start on
#   anything older. Building on bookworm (glibc 2.36) rather than the newest available
#   base buys compatibility with older targets for free.
#
# PyInstaller cannot cross-compile: this produces a Linux x86-64 binary only. macOS and
# Windows builds have to run on macOS and Windows.

FROM python:3.13-slim-bookworm

# Set by CI to the commit being built. Labels the image so an artefact can be traced
# back to a revision; the binary itself is not stamped yet.
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.description="agentic workflow engine build"

# The engine shells out to these at runtime. They are installed here so the example
# flows can be exercised inside the image as a build-time smoke test; a machine running
# the finished binary needs them too.
RUN apt-get update \
 && apt-get install -y --no-install-recommends binutils jq openssl xxd coreutils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Pinned dependencies first, so editing the engine does not re-resolve them and so two
# builds of the same commit embed the same wheels.
COPY packaging/requirements-lock.txt ./packaging/
RUN pip install --no-cache-dir -r packaging/requirements-lock.txt

# The project itself, with --no-deps: everything it needs is already pinned above, and
# pyproject.toml stays the single declaration of what those dependencies are. LICENSE
# comes along because pyproject's license-files names it, and the install below fails on
# a pattern matching no file.
COPY pyproject.toml LICENSE ./
COPY src ./src

# Before the install, not after: pyproject.toml's version is dynamic and read out of
# src/cli/branding.py here, and atf.spec freezes the installed distribution rather than this
# tree. Stamping later would leave the binary reporting the placeholder.
#
# Unset on a pull request, where there is no tag and the placeholder is the honest answer.
# Only the one script is copied, so editing release.sh does not invalidate the install below.
ARG VERSION=
COPY packaging/stamp_version.py ./packaging/
RUN if [ -n "$VERSION" ]; then python packaging/stamp_version.py "$VERSION"; fi

RUN pip install --no-cache-dir --no-deps .

COPY packaging ./packaging
# Fail now if the lock and pyproject.toml have drifted apart, rather than shipping a
# binary missing a dependency nobody notices until the command that needs it runs.
RUN python packaging/verify_deps.py

COPY examples ./examples

RUN pyinstaller --clean --noconfirm --distpath /out --workpath /tmp/pyi packaging/atf.spec

# Fail the build rather than ship a binary that cannot see its own built-ins. That is the
# exact failure that made this packaging work necessary.
#
# The version is checked here rather than trusted. Moving the stamp after `pip install`
# leaves it writing a source tree nothing reads again: the build succeeds, every test below
# passes, and the binary reports the placeholder. release.sh would catch it a job later,
# once the artefact exists and has been uploaded.
RUN /out/atf/atf --version \
 && { [ -z "$VERSION" ] || /out/atf/atf --version | grep -Fqx "atf ${VERSION#v}"; } \
 && /out/atf/atf list | tee /tmp/list.txt \
 && grep -q read_file   /tmp/list.txt \
 && grep -q write_file  /tmp/list.txt \
 && grep -q claude_code /tmp/list.txt \
 && grep -qw echo       /tmp/list.txt \
 && /out/atf/atf --workspace examples/sign-release lint sign_release \
 && /out/atf/atf completion bash | grep -q _atf_complete \
 && printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
      | /out/atf/atf --workspace examples/sign-release mcp-serve | grep -q '"serverInfo"' \
 && /out/atf/atf --workspace examples/sign-release __complete -- run "" | grep -q '^sign_release$' \
 && ATF_VAULT_PASSWORD=demo /out/atf/atf \
      --workspace examples/sign-release run sign_release --input path=release-notes.md \
      | grep -q '^b3b7f6ca731a0de0d59f59aaf5c3ed4f6c0b7eb76cf513ae81cf5ed7a025005b  release-notes.md$' \
 && echo "smoke tests passed"

# Flatten to a single directory for `docker cp`.
RUN mkdir -p /out && ls /out/atf > /dev/null
